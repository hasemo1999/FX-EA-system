{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python rough_backtest.py *)",
      "Bash(python atrq_grid_scan.py *)",
      "Bash(python analyze_atr_gap.py *)",
      "Bash(python session_filter.py *)",
      "Bash(pip install -r requirements.txt)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -q 'backtest_config_production.json'; then echo '⚠️ 本番設定ファイルの直接編集は禁止です。別ファイルで検証してください。' >&2; exit 1; fi"
          }
        ]
      }
    ]
  }
}
